# GameTracker API keys (optional). Copy to `.env` and fill in.
# Read at COMPILE time by src-tauri/build.rs and baked into the binary, so
# rebuild the Rust crate (`npm run tauri dev` / `tauri build`) after changing.

# RAWG (https://rawg.io/apidocs) — metadata fallback for games not on Steam.
RAWG_API_KEY=

# YouTube Data API v3 (https://console.cloud.google.com) — finds the full-length
# theme/OST video for the per-game theme player. Without it, a 30s iTunes
# soundtrack preview is used instead (keyless).
YOUTUBE_API_KEY=

# SteamGridDB (https://www.steamgriddb.com/profile/preferences/api) — OPTIONAL.
# Covers for non-Steam games (ZZZ, Wuthering Waves, etc.) already work keylessly
# via Wikipedia box art (then the RAWG background). A SteamGridDB key just upgrades
# those to nicer dedicated 600x900 portrait art. Leave blank to stay fully keyless.
STEAMGRIDDB_API_KEY=
