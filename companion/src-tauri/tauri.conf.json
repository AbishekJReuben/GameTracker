{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameTracker Remote",
  "version": "3.9.38",
  "identifier": "com.chilloutgames.gametracker.companion",
  "build": {
    "frontendDist": "../../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "GameTracker Remote",
        "url": "companion.html",
        "width": 420,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
