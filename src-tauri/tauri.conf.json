{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tracker",
  "version": "3.8.5",
  "identifier": "com.chilloutgames.gametracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tracker",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "dragDropEnabled": true,
        "backgroundColor": "#08090f",
        "theme": "Dark"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/**",
          "$APPDATA/**"
        ]
      },
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data: blob:; media-src 'self' asset: http://asset.localhost https: data: blob:; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://player.twitch.tv; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' ipc: http://ipc.localhost https://discovery.chilloutgamestudio.com wss://discovery.chilloutgamestudio.com https://*.chilloutgamestudio.com wss://*.chilloutgamestudio.com stun: turn: turns:"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/AbishekJReuben/GameTracker/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0QjM0QTREQTU2RTEzNkMKUldSc0UyNmxUVXF6ZEs4eTlHcVI0dmErL1RwR1RDS2dZUFRXQ1Eyb3NvdWJxb2U4Y2NsZHNoWWUK",
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/sensorbridge"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerHooks": "installer/hooks.nsh",
        "template": "installer/template.nsi"
      }
    }
  }
}
